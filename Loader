-- Función de notificación estilo Rayfield con borde rainbow y esquinas redondas
local function SendRayfieldNotification(titleText, contentText, duration)
	duration = duration or 4

	local NotifFrame = Instance.new("Frame")
	NotifFrame.Size = UDim2.new(1, 0, 0, 74)
	NotifFrame.Position = UDim2.new(1.2, 0, 0, 0)
	NotifFrame.BackgroundColor3 = Color3.fromRGB(20, 20, 27)
	NotifFrame.BorderSizePixel = 0
	NotifFrame.ClipsDescendants = true
	NotifFrame.Parent = NotifyHolder

	local NotifCorner = Instance.new("UICorner")
	NotifCorner.CornerRadius = UDim.new(0, 14)
	NotifCorner.Parent = NotifFrame

	local NotifStroke = Instance.new("UIStroke")
	NotifStroke.Thickness = 2
	NotifStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	NotifStroke.Parent = NotifFrame

	local NotifTitle = Instance.new("TextLabel")
	NotifTitle.Size = UDim2.new(1, -18, 0, 22)
	NotifTitle.Position = UDim2.new(0, 12, 0, 7)
	NotifTitle.BackgroundTransparency = 1
	NotifTitle.Text = titleText
	NotifTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
	NotifTitle.Font = Enum.Font.GothamBold
	NotifTitle.TextSize = 14
	NotifTitle.TextXAlignment = Enum.TextXAlignment.Left
	NotifTitle.Parent = NotifFrame

	local NotifBody = Instance.new("TextLabel")
	NotifBody.Size = UDim2.new(1, -18, 0, 26)
	NotifBody.Position = UDim2.new(0, 12, 0, 29)
	NotifBody.BackgroundTransparency = 1
	NotifBody.Text = contentText
	NotifBody.TextColor3 = Color3.fromRGB(215, 215, 225)
	NotifBody.Font = Enum.Font.GothamMedium
	NotifBody.TextSize = 13
	NotifBody.TextXAlignment = Enum.TextXAlignment.Left
	NotifBody.Parent = NotifFrame

	local ProgressBg = Instance.new("Frame")
	ProgressBg.Size = UDim2.new(1, 0, 0, 4)
	ProgressBg.Position = UDim2.new(0, 0, 1, -4)
	ProgressBg.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
	ProgressBg.BorderSizePixel = 0
	ProgressBg.Parent = NotifFrame

	local ProgressBar = Instance.new("Frame")
	ProgressBar.Size = UDim2.new(1, 0, 1, 0)
	ProgressBar.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	ProgressBar.BorderSizePixel = 0
	ProgressBar.Parent = ProgressBg

	local hue = 0
	local conn = RunService.RenderStepped:Connect(function(dt)
		if not NotifFrame or not NotifFrame.Parent then return end
		hue = (hue + dt * 0.3) % 1
		local c = Color3.fromHSV(hue, 0.85, 1)
		NotifStroke.Color = c
		ProgressBar.BackgroundColor3 = c
	end)

	TweenService:Create(NotifFrame, TweenInfo.new(0.35, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
		Position = UDim2.new(0, 0, 0, 0)
	}):Play()

	TweenService:Create(ProgressBar, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
		Size = UDim2.new(0, 0, 1, 0)
	}):Play()

	task.delay(duration, function()
		if NotifFrame and NotifFrame.Parent then
			local outTween = TweenService:Create(NotifFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.In), {
				Position = UDim2.new(1.2, 0, 0, 0)
			})
			outTween:Play()
			outTween.Completed:Wait()
			if conn then conn:Disconnect() end
			NotifFrame:Destroy()
		end
	end)
end

