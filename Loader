local hue = 0
local RainbowConnection
RainbowConnection = RunService.RenderStepped:Connect(function(deltaTime)
	if not ScreenGui or not ScreenGui.Parent then
		RainbowConnection:Disconnect()
		return
	end
	hue = (hue + deltaTime * 0.25) % 1
	MainStroke.Color = Color3.fromHSV(hue, 0.85, 1)
	LeftStroke.Color = Color3.fromHSV((hue + 0.1) % 1, 0.85, 1)
	DiscordStroke.Color = Color3.fromHSV((hue + 0.2) % 1, 0.85, 1)
	LaunchStroke.Color = Color3.fromHSV((hue + 0.35) % 1, 0.85, 1)
end)

