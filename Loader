-- ==========================================
-- CONFIGURACIÓN DE JUEGOS Y SCRIPTS
-- ==========================================
local GamesDatabase = {
	-- MM2 (Murder Mystery 2)
	[142823291] = {
		Name = "MM2",
		Execute = function()
			loadstring(game:HttpGet("https://raw.githubusercontent.com/talleresdeinglesliceo-jpg/Murders/refs/heads/main/Famyly"))()
		end
	},

	-- Entrenador 5v5 (Reemplaza 000000000 por el PlaceId o GameId real si deseas forzarlo)
	[000000000] = {
		Name = "Entrenador 5v5",
		Execute = function()
			loadstring(game:HttpGet("https://raw.githubusercontent.com/talleresdeinglesliceo-jpg/5v5/refs/heads/main/Heaven"))()
		end
	},
}

local FallbackByName = {
	["murder mystery 2"] = GamesDatabase[142823291],
	["mm2"] = GamesDatabase[142823291],
	["entrenador 5v5"] = GamesDatabase[000000000],
	["5v5"] = GamesDatabase[000000000],
}

local CurrentPlaceId = game.PlaceId
local CurrentGameId = game.GameId
local DetectedGameName = "Desconocido"
local SelectedGameData = nil

pcall(function()
	local info = MarketplaceService:GetProductInfo(CurrentPlaceId)
	if info and info.Name then
		DetectedGameName = info.Name
	end
end)

if GamesDatabase[CurrentPlaceId] then
	SelectedGameData = GamesDatabase[CurrentPlaceId]
elseif GamesDatabase[CurrentGameId] then
	SelectedGameData = GamesDatabase[CurrentGameId]
else
	local lowerName = string.lower(DetectedGameName)
	for keyword, data in pairs(FallbackByName) do
		if string.find(lowerName, keyword, 1, true) then
			SelectedGameData = data
			break
		end
	end
end

