-- ==========================================
-- ANIMACIÓN BORDES RAINBOW
-- ==========================================
local hue = 0
local RainbowConnection
RainbowConnection = RunService.RenderStepped:Connect(function(deltaTime)
	if not ScreenGui or not ScreenGui.Parent then
		RainbowConnection:Disconnect()
		return
	end
	hue = (hue + deltaTime * 0.25) % 1
	local mainColor = Color3.fromHSV(hue, 0.85, 1)
	local buttonColor = Color3.fromHSV((hue + 0.15) % 1, 0.85, 1)

	MainStroke.Color = mainColor
	LaunchStroke.Color = buttonColor
end)

LaunchButton.MouseEnter:Connect(function()
	TweenService:Create(LaunchButton, TweenInfo.new(0.2), {BackgroundColor3 = LaunchHoverColor}):Play()
end)

LaunchButton.MouseLeave:Connect(function()
	TweenService:Create(LaunchButton, TweenInfo.new(0.2), {BackgroundColor3 = LaunchNormalColor}):Play()
end)

-- Lógica al presionar LAUNCH
LaunchButton.MouseButton1Click:Connect(function()
	if SelectedGameData and SelectedGameData.Execute then
		LaunchButton.Text = "CARGANDO..."
		task.wait(0.3)
		SelectedGameData.Execute()
		ScreenGui:Destroy()
	else
		SendRayfieldNotification("Family Loader", "not suport game", 4)
		LaunchButton.Text = "NOT SUPORT GAME"
		task.wait(1.2)
		LaunchButton.Text = "LAUNCH"
	end
end)
